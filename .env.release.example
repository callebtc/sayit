# Copy this file to .env.release and fill in the three non-secret values.
# Keep Apple credentials in the Keychain profile created by notarytool.

SAYIT_SIGN_IDENTITY='Developer ID Application identity or SHA-1 fingerprint'
SAYIT_NOTARY_PROFILE='sayit-notary'
SAYIT_UPDATE_API_URL='https://api.github.com/repos/OWNER/REPOSITORY/releases/latest'

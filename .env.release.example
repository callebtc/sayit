# Copy this file to .env.release and fill in the three non-secret values.
# Keep Apple credentials in the Keychain profile created by notarytool.

SAYIT_SIGN_IDENTITY='Developer ID Application identity or SHA-1 fingerprint'
SAYIT_NOTARY_PROFILE='sayit-notary'
SAYIT_UPDATE_FEED_URL='https://github.com/OWNER/REPOSITORY/releases/latest/download/appcast.xml'
# The Sparkle private seed is stored separately in ignored .env.
# SAYIT_UPDATE_KEY_FILE='.env'
# Optional: directory containing generate_appcast and sign_update.
# SAYIT_SPARKLE_TOOLS_DIR=''

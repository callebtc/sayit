    "Applied to newly spoken text. Keeping the model in memory avoids reload delays. Block separators are a visual debugging aid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对之后新朗读的文本生效。将模型保留在内存中可避免重复加载延迟。分段分隔线仅用于可视化调试。"
          }
        }
      }
    },
    "Apply Changes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用更改"
          }
        }

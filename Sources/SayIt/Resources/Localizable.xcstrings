    "A file named “sayit” already exists in %@. Remove it manually or choose another folder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中已存在名为“sayit”的文件。请手动移除或选择其他文件夹。"
          }
        }
      }
    },
    "A local reference profile — no training, nothing uploaded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地参考音色配置——无需训练，不上传任何数据。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限范围"
          }
        }
      }
    },
    "Access token created": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已创建访问令牌"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "Accessibility Settings couldn’t be opened. Open System Settings, choose Privacy & Security, then Accessibility.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开“辅助功能”设置。请前往“系统设置”→“隐私与安全性”→“辅助功能”。"
          }
        }
      }
    },
    "Accessibility access is off. Allow the Say It selected-text helper in Accessibility Settings, then press the shortcut again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未开启辅助功能权限。请在“辅助功能”设置中允许 Say It 选中文本助手，然后再按一次快捷键。"
          }
        }
      }
    },
    "Accessibility is used only when you invoke the selection shortcut. Clipboard text is read only when you invoke its shortcut.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在您按下朗读选中文本快捷键时才会使用辅助功能；仅在按下剪贴板快捷键时才会读取剪贴板。"
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "致谢"
          }
        }
      }
    },

        }
      }
    },
    "Allow Say It in System Settings → General → Login Items & Extensions to finish starting the service.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”→“通用”→“登录项与扩展”中允许 Say It，以完成启动后台服务。"
